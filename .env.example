NODE_ENV=development

# Banco de dados (Postgres via docker-compose.dev.yml, Task 2)
DATABASE_URL=postgres://egd:egd@localhost:5432/egd
# Opcional. Banco dos testes de integração; padrão: DATABASE_URL com o nome + "_test" (egd_test).
# O nome precisa terminar em "_test": o setup trunca tabelas e recusa qualquer outro banco.
# TEST_DATABASE_URL=postgres://egd:egd@localhost:5432/egd_test

# Auth (better-auth)
BETTER_AUTH_SECRET=changeme-troque-por-32-caracteres-aleatorios
BETTER_AUTH_URL=http://localhost:3000
# Origens extras aceitas no login (opcional), separadas por vírgula
BETTER_AUTH_TRUSTED_ORIGINS=

# SMTP (Mailpit local (captura e-mails em http://localhost:8025) via docker-compose.dev.yml, Task 2)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EGD <no-reply@egdsystem.com.br>
ADMIN_NOTIFY_EMAIL=admin@egdsystem.com.br

# Armazenamento de objetos S3-compatível (RustFS local via docker-compose.dev.yml)
S3_ENDPOINT=http://localhost:9000
# Endereço do storage que o navegador alcança (assina os downloads). Em produção: https://storage.egdsystem.com.br
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=egd
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345

# Automações (Fase 13): agendador dentro do app. "1" liga, "0" desliga; sem valor, ligado só em produção.
# JOBS_ENABLED=0

# Seed do admin inicial (opcional)
SEED_ADMIN_EMAIL=admin@egdsystem.com.br
SEED_ADMIN_PASSWORD=troque-esta-senha-local
